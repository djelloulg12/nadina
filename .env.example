# ============================================================
#  ملف البيئة-example
#  انسخ هذا الملف إلى .env ثم عدّل القيم
#  cp .env.example .env
# ============================================================

# --- التطبيق ---
APP_NAME=المنصة الشاملة
APP_ENV=development
DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Algiers

# --- الأمان ---
# ولّد مفتاحاً عشوائياً بالأمر:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_48_char_random_secret_key_here
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- قاعدة البيانات ---
# للتجربة المحلية: SQLite
DB_DRIVER=sqlite
SQLITE_PATH=data/sports_clubs.db

# للإنتاج: PostgreSQL
# DB_DRIVER=postgresql
# POSTGRES_USER=sports
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=sports_clubs

# أو رابط كامل (يتجاوز كل ما سبق)
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db

DB_ECHO=false

# --- الخدمات الخارجية ---
SMS_ENABLED=false
EMAIL_ENABLED=false
PUSH_ENABLED=false
SCHEDULER_ENABLED=true

# --- إعدادات الأعمال ---
RENEWAL_ALERT_DAYS=7
MAX_UPLOAD_SIZE_MB=8
ALLOW_PUBLIC_CLUB_REGISTRATION=true