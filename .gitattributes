# ====================================================================
#  تطبيع أسطر نهاية الملفات
# ====================================================================
#
# المستودع يُقرأ على Windows ولينكس
# تُحوّل LF إلى CRLF، وعلى Linux يبقى CRLF.
#
# سكريبت shell مع CRLF يفشل عند التنفيذ،
# ونصوص Python مع CRLF تجعل فروق الفحوص
# غير متوقّعة.
#
# الحل: نُخزّن LF في المستودع، ويتحوّل
# كل نظام إلى نهايته المفضّلة.
# ====================================================================

# افتراضي: كل النصوص تُخزّن بـ LF
* text=auto eol=lf

# نصوص ثنائية: لا تُلمس
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# ملفات تُنفّذ على Linux
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.mako text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
